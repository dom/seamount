# /etc/pi-forge/pi-forge.env — environment for pi-forge.service
#
# Phase 5 (Plan 05-01) — Thermocline reference deployment at https://pi.dom.net.
# Sources: seamount/pi-forge/server.py:42-48 (FORGE_* vars); pi_forge/__main__.py:75
# (FORGE_BIND_HOST — there is NO --host CLI flag, only the env var).
#
# Installed by deploy/install.sh § Section 6 at /etc/pi-forge/pi-forge.env
# with mode 0640, owner pi-forge:pi-forge. Loaded by pi-forge.service via
# EnvironmentFile=. Never logged; do not commit deployment-specific secrets here.

# Deployment identity advertised in task_result.forge_node_id (CONTEXT D-02).
FORGE_NODE_ID=pi-forge.pi.dom.net

# CONTEXT D-02 / Phase 3 D-01: brine is the default; pinned explicitly here so
# a future upstream change cannot silently flip the deploy to FORGE_KEY_SCHEME=none.
FORGE_KEY_SCHEME=brine

# CONTEXT D-02: 8001 is owned by example-cotenant.service on this box (preserved).
# pi-forge runs on 8002, loopback-only, reverse-proxied by Caddy.
FORGE_PORT=8002

# CRITICAL — CONTEXT D-02 / RESEARCH Pitfall 2.
# pi_forge/__main__.py has NO --host CLI flag; bind host is env-var-only
# (line 75). Upstream default is 0.0.0.0 (server.py:174 nit, deferred to v0.2).
# The systemd unit's --host flag does NOT exist; this env var is the override.
FORGE_BIND_HOST=127.0.0.1

# Libsecret namespace under which the brine keypair is stored.
PIFORGE_KEYRING_SERVICE=seamount.piforge

# CONTEXT D-08: identity is the keystore-entry name, NOT the deployment URL.
# The URL is for evaluators; the identity is for receipt-signature trust.
PIFORGE_IDENTITY=pi-forge
