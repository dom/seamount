# /etc/pi-forge/pi-forge.env — environment for pi-forge.service
#
# Sources: pi-forge/server.py FORGE_* env vars + pi_forge/__main__.py
# FORGE_BIND_HOST (there is no --host CLI flag; bind host is env-var-only).
#
# Installed by deploy/install.sh §6 at /etc/pi-forge/pi-forge.env with
# mode 0640, owner pi-forge:pi-forge. Loaded by pi-forge.service via
# EnvironmentFile=. Never logged; do not commit deployment-specific secrets here.

# FORGE_NODE_ID is the node_id used in the receipt's `responder` field AND
# as the keystore-lookup key when signing. Must match PIFORGE_IDENTITY
# below — server.py passes FORGE_NODE_ID as `responder` to
# build_task_result(), and envelope.py calls
# provider.sign(signer_identity=responder), which looks up the brine key
# in libsecret by that name.
#
# The spec (thermocline/README.md "Schema" section) says responder is a node
# identifier, NOT a URL. Use a short stable name (e.g. `pi-forge`); the
# public hostname belongs in seamount/pi-forge/README.md §"Live Reference
# Deployment" as evaluator-facing metadata, not in receipts.
FORGE_NODE_ID=pi-forge

# brine is the default; pinned explicitly here so a future upstream change
# cannot silently flip the deploy to FORGE_KEY_SCHEME=none.
FORGE_KEY_SCHEME=brine

# pi-forge listens on 8002, loopback-only (FORGE_BIND_HOST=127.0.0.1).
# Caddy reverse-proxies the public traffic from 443 to 127.0.0.1:8002.
FORGE_PORT=8002

# pi_forge/__main__.py has NO --host CLI flag; bind host is env-var-only.
# Upstream default is 127.0.0.1 as of 0.4.0 (0.0.0.0 is explicit opt-in).
# Kept explicit here so the only public path is via Caddy (TLS + ACME +
# log isolation).
FORGE_BIND_HOST=127.0.0.1

# Libsecret namespace under which the brine keypair is stored.
PIFORGE_KEYRING_SERVICE=seamount.piforge

# Identity is the keystore-entry name, NOT the deployment URL. The URL is
# for evaluators; the identity is for receipt-signature trust.
PIFORGE_IDENTITY=pi-forge
